<Window x:Class="TTB.LabelVerifier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TTB Label Verifier"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7">

    <Window.InputBindings>
        <!-- Keyboard Shortcuts -->
        <KeyBinding Key="F1" Command="{Binding NavigateSingleCheckCommand}" />
        <KeyBinding Key="F2" Command="{Binding NavigateBatchCheckCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- HEADER BAR -->
        <Border Background="#2D4A7A" Height="55" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20 0">
                <TextBlock Text="TTB Label Verifier"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border Background="#E5E5E5" Height="28" DockPanel.Dock="Bottom">
            <TextBlock Text="Ready"
                       VerticalAlignment="Center"
                       Margin="10 0"
                       Foreground="#444"/>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- NAVIGATION PANEL -->
            <StackPanel Background="#F0F0F0"  VerticalAlignment="Stretch">

                <TextBlock Text="Navigation"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0 0 0 20"
                           Foreground="#333"/>

                <!-- Single Check -->
                <Button Command="{Binding NavigateSingleCheckCommand}"
                        Height="45"
                        Margin="0 10 0 0"
                        Background="#FFFFFF"
                        BorderBrush="#CCCCCC"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="18" Margin="0 0 10 0"/>
                        <TextBlock Text="Single Check" FontSize="16"/>
                    </StackPanel>
                </Button>

                <!-- Batch Check -->
                <Button Command="{Binding NavigateBatchCheckCommand}"
                        Height="45"
                        Margin="0 10 0 0"
                        Background="#FFFFFF"
                        BorderBrush="#CCCCCC"
                        HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontSize="18" Margin="0 0 10 0"/>
                        <TextBlock Text="Batch Check" FontSize="16"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- ACTIVE VIEW -->
            <Border Grid.Column="1"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="15"
                    Background="White">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>

        </Grid>
    </DockPanel>
</Window>
